<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      AUD-M17: the core library also targets netstandard2.0 (.NET Framework 4.6.1+), so the suite additionally runs on
      net48 when building on Windows (the Windows CI job); Linux and macOS builds (Docker, Linux CI) cannot run
      .NET Framework and build net10.0 only.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net48</TargetFrameworks>
    <RootNamespace>Iwxxm.Net.Tests</RootNamespace>
    <AssemblyName>Iwxxm.Net.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Package versions are managed centrally in Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Iwxxm.Net\Iwxxm.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Samples\**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Byte-identical copies of the official WMO BUFR code tables (wmo-im/iwxxm IWXXM/rule/*.rdf) -->
    <None Update="TestData\**\*.rdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Characterization (golden-master) outputs; regenerate with IWXXM_UPDATE_GOLDEN=1 (see CONTRIBUTING.md) -->
    <None Update="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
