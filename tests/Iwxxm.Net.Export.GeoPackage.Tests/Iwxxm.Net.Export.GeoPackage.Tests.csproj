<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Like the core test project: net10.0 everywhere, plus net48 when building on Windows or when IWXXM_TEST_NET48=true is
      set. net48 is what verifies that the netstandard2.0 package finds its native SQLite on .NET Framework (the Windows CI
      job runs the real .NET Framework; the container pipeline runs it under Mono, see the Dockerfile).
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' Or '$(IWXXM_TEST_NET48)' == 'true'">net10.0;net48</TargetFrameworks>
    <RootNamespace>Iwxxm.Net.Export.GeoPackage.Tests</RootNamespace>
    <AssemblyName>Iwxxm.Net.Export.GeoPackage.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Package versions are managed centrally in Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- .NET Framework has no System.Text.Json; the tests use it to parse the GeoJSON output (test-only, never shipped) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- The official WMO examples live in the core test project; they are linked, never copied into this one. -->
  <ItemGroup>
    <None Include="..\Iwxxm.Net.Tests\Samples\wmo-examples\*.xml" Link="Samples\wmo-examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    More real documents with geometry from the same project, linked under Samples/extra: the SIGWX examples (the small one and
    the 14 MB synthetic WAFS bulletin with 4252 features).
  -->
  <ItemGroup>
    <None Include="..\Iwxxm.Net.Tests\Samples\sigwx-swh-2025-2.xml" Link="Samples\extra\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Iwxxm.Net.Tests\Samples\external\metoffice\example-iwxxm-2025-2-sigwx-non-operational.xml" Link="Samples\extra\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Golden canonical dumps; regenerate with IWXXM_UPDATE_GOLDEN=1 (see GeoPackageGoldenTests). -->
  <ItemGroup>
    <None Update="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Iwxxm.Net.Export.GeoPackage\Iwxxm.Net.Export.GeoPackage.csproj" />
  </ItemGroup>

</Project>
