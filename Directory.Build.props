<Project>

  <PropertyGroup>
    <!-- C# Compiler & Code Quality Standards -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>
    <!-- Fixed analyzer level (AUD-M18): a newer SDK does not silently add rules that would fail the warnings-as-errors build. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

    <!-- Continuous Integration Deterministic Paths -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Semantic Versioning 2.0 (Overridable by CI/CD incremental build number) -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">rc.1</VersionSuffix>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">1.0.0.1</FileVersion>

    <!-- Common NuGet Package Metadata -->
    <Authors>0neTX</Authors>
    <Copyright>Copyright (c) 2026 0neTX</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/0neTX/Iwxxm.Net.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/0neTX/Iwxxm.Net</PackageProjectUrl>
    <PackageReleaseNotes>See CHANGELOG.md at $(PackageProjectUrl)/blob/main/CHANGELOG.md for the release notes of this version.</PackageReleaseNotes>

    <!-- NuGet Package Validation: `dotnet pack` checks that each package is consistent across its target frameworks (for
         example netstandard2.0 vs netstandard2.1 API differences). It is set unconditionally: the validation only runs as
         part of pack, which the non-packable projects never run, and a condition on IsPackable would always be false here
         because the projects set IsPackable after this file is evaluated. No baseline is used, by decision
         (PackageValidationBaselineVersion is not set anywhere): breaking API changes against earlier releases are NOT checked. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- Symbol Package (.snupkg) & SourceLink Best Practices -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
