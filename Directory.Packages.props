<Project>

  <PropertyGroup>
    <!-- Enable Central Package Management (CPM) across the entire solution -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Optional Iwxxm.Net.Validation.Saxon package: XSLT 3.0 engine (MPL-2.0, net10.0 only) -->
    <PackageVersion Include="SaxonCS-HE" Version="13.1.0" />

    <!-- Optional Iwxxm.Net.Export.GeoPackage package: SQLite writer (MIT; brings SQLitePCLRaw 2.1.13 and the native SQLite binaries, Apache-2.0).
         10.0.x is the last line with a netstandard2.0 asset (11.0 targets net10.0 only), which the package needs for .NET Framework. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />

    <!-- Test project dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- IL-level architecture rules (test-only; never referenced by a packable project) -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Property-based testing (test-only). 2.14.1 is the last CsCheck release that targets netstandard2.0, which the optional
         net48 test target needs (CsCheck 3.x targets net6.0, 4.x net8.0, 5.x net10.0+ only). -->
    <PackageVersion Include="CsCheck" Version="2.14.1" />

    <!-- net48 test target only (AUD-M17): System.Text.Json is not part of .NET Framework -->
    <PackageVersion Include="System.Text.Json" Version="9.0.10" />

    <!-- Benchmark suite dependencies -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
