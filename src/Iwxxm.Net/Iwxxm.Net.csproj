<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Dual compatibility with .NET Framework 4.8 and .NET 8+ -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Iwxxm.Net</RootNamespace>
    <AssemblyName>Iwxxm.Net</AssemblyName>

    <!-- NuGet Packaging Configuration (inherits version 1.0.0-rc.1 and metadata from Directory.Build.props) -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Iwxxm.Net</PackageId>
    <Title>Iwxxm.Net — ICAO/WMO IWXXM Aeronautical Meteorology Processor for .NET</Title>
    <Product>Iwxxm.Net</Product>
    <Description>Zero-dependency .NET Standard 2.0 library for dual validation (XSD + Schematron XSLT) and Domain-Driven Design (DDD) parsing of ICAO/WMO IWXXM 2025-2 aeronautical meteorological reports (including WAFS SIGWX, JetStream, Clouds, Tropopause, and Volcanoes).</Description>
    <PackageTags>IWXXM;IWXXM-2025-2;Iwxxm.Net;SIGWX;WAFS;METAR;TAF;SIGMET;AIRMET;VONA;QVACI;WMO;ICAO;SWIM;GML;Aviation;Meteorology;XML</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- 
    =========================================================================
    ARCHITECTURAL CONSTRAINT: VANILLA C# AT RUNTIME
    Zero third-party runtime dependencies are included. Microsoft.SourceLink.GitHub
    is marked with PrivateAssets="all" so it only runs at build time for PDB
    source linking without adding any runtime NuGet dependency to the package.
    =========================================================================
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- 
    =========================================================================
    EMBEDDED RESOURCES (Official XSD Schemas & Precompiled Schematron XSLT)
    Explicit LogicalName metadata ensures deterministic resolution via
    Assembly.GetManifestResourceStream and EmbeddedXmlUrlResolver.
    =========================================================================
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Xsd\**\*.xsd">
      <LogicalName>Iwxxm.Net.Resources.Xsd.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Schematron\**\*.xslt">
      <LogicalName>Iwxxm.Net.Resources.Schematron.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 
    =========================================================================
    DESIGN-TIME XSD CLASS GENERATION TARGET
    =========================================================================
    Uses the local .NET tool manifest (.config/dotnet-tools.json) defining
    'dotnet-xscgen' (XmlSchemaClassGenerator-console).

    Restore local tools:
      dotnet tool restore

    On-demand MSBuild execution:
      dotnet build -p:RegenerateXsdClasses=true
  -->
  <Target Name="GenerateXsdClasses" BeforeTargets="CoreCompile" Condition="'$(RegenerateXsdClasses)' == 'true'">
    <Message Importance="high" Text="Restoring local .NET tools and autogenerating C# classes from IWXXM 2025-2 and GML 3.2 XSD schemas..." />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
    <Exec Command="dotnet tool run xscgen -n &quot;http://icao.int/iwxxm/2025-2=Iwxxm20252.Generated&quot; -n &quot;http://www.opengis.net/gml/3.2=Iwxxm20252.Generated&quot; -n &quot;http://www.w3.org/1999/xlink=Iwxxm20252.Generated&quot; -o &quot;$(MSBuildProjectDirectory)/Infrastructure/Generated&quot; --singleFile --internal --nullable &quot;$(MSBuildProjectDirectory)/Resources/Xsd/xlink.xsd&quot; &quot;$(MSBuildProjectDirectory)/Resources/Xsd/gml.xsd&quot; &quot;$(MSBuildProjectDirectory)/Resources/Xsd/iwxxm-sigwx.xsd&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
  </Target>

</Project>
