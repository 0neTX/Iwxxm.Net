<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target .NET Standard 2.0 (.NET Framework 4.6.1-4.8) and .NET Standard 2.1 (.NET Core 3.0+ / .NET 5-9+) -->
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>Iwxxm.Net</RootNamespace>
    <AssemblyName>Iwxxm.Net</AssemblyName>

    <!-- NuGet Packaging Configuration (inherits version 1.0.0-rc.1 and metadata from Directory.Build.props) -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Iwxxm.Net</PackageId>
    <Title>Iwxxm.Net — ICAO/WMO IWXXM Aeronautical Meteorology Processor for .NET</Title>
    <Product>Iwxxm.Net</Product>
    <Description>Zero-dependency .NET Standard 2.0 &amp; 2.1 library for ICAO/WMO IWXXM 2025-2: XSD validation against the embedded, unmodified official WMO IWXXM 2025-2 schemas (with official GML 3.2.1, AIXM 5.1.1, METCE and COLLECT imports), partial built-in business-rule validation (an XSLT 1.0 subset of the official Schematron: 11 of 165 official rule IDs, plus official WMO RDF code-list membership checks; the complete official Schematron is available through the optional Iwxxm.Net.Validation.Saxon package and pluggable validation ports), Domain-Driven Design (DDD) parsing, and Native RFC 7946 GeoJSON export of the full ICAO/WMO IWXXM 2025-2 aeronautical meteorological suite (SIGWX/WAFS, METAR, SPECI, TAF, SIGMET, AIRMET, VONA, QVACI, Volcanic Ash/Tropical Cyclone/Space Weather Advisories, and SWIM Collect Bulletins).</Description>
    <PackageTags>IWXXM;IWXXM-2025-2;Iwxxm.Net;SIGWX;WAFS;METAR;SPECI;TAF;SIGMET;AIRMET;VONA;QVACI;WMO;ICAO;SWIM;GML;AIXM;XSD;Schematron;Aviation;Meteorology;XML</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- 
    =========================================================================
    ARCHITECTURAL CONSTRAINT: VANILLA C# AT RUNTIME
    Zero third-party runtime dependencies are included. Microsoft.SourceLink.GitHub
    is marked with PrivateAssets="all" so it only runs at build time for PDB
    source linking without adding any runtime NuGet dependency to the package.
    =========================================================================
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <InternalsVisibleTo Include="Iwxxm.Net.Tests" />
    <InternalsVisibleTo Include="Iwxxm.Net.Benchmarks" />
  </ItemGroup>

  <!--
    =========================================================================
    EMBEDDED RESOURCES (Official WMO XSD Schemas, Schematron XSLT & RDF Codelists)
    - Resources/Xsd/Official: byte-identical copies of the official WMO IWXXM 2025-2
      schemas (wmo-im/iwxxm IWXXM/*.xsd) and of the external schemas they import
      (externalSchema/: OGC GML 3.2.1, OGC O&M 2.0, ISO 19139, AIXM 5.1.1, WMO METCE 1.2,
      WMO OPM 1.2, WMO COLLECT 1.2, W3C XLink/XML). Only files reachable from
      iwxxm.xsd and iwxxm-collect.xsd are included. Never edit these files.
    - Resources/Xsd/Legacy: NON-STANDARD hand-written schema subset used only for the
      compact iwxxm:SIGWXReport extension root (not part of any official schema).
    - Resources/Codelists: the 20 official WMO RDF/SKOS code lists (IWXXM/rule/*.rdf).
    Logical names preserve the relative path ("Iwxxm.Net/Resources/...") to avoid
    file-name collisions; EmbeddedXmlUrlResolver maps schemaLocation URLs onto them.
    =========================================================================
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Xsd\Official\**\*.xsd">
      <LogicalName>Iwxxm.Net/$([System.String]::Copy('%(RelativeDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Xsd\Legacy\xlink.xsd;Resources\Xsd\Legacy\gml.xsd;Resources\Xsd\Legacy\aixm.xsd;Resources\Xsd\Legacy\iwxxm-sigwx.xsd">
      <LogicalName>Iwxxm.Net/$([System.String]::Copy('%(RelativeDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Schematron\**\*.xslt">
      <LogicalName>Iwxxm.Net/$([System.String]::Copy('%(RelativeDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Codelists\**\*.rdf">
      <LogicalName>Iwxxm.Net/$([System.String]::Copy('%(RelativeDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Upstream ReadMe / release-note files that accompany the official schemas (OGC, ISO, WMO) -->
  <ItemGroup>
    <None Include="Resources\Xsd\Official\**\*.txt" Pack="true" PackagePath="schema-notices\%(RecursiveDir)" />
  </ItemGroup>

  <!--
    =========================================================================
    TRANSPORT MODEL (Infrastructure/Generated/Iwxxm20252.Generated.cs)
    =========================================================================
    The internal SIGWX transport classes are hand-maintained; no build target
    regenerates them. tools/generate-xsd-classes.sh writes an optional xscgen
    reference scaffold to artifacts/xscgen-reference/ for manual comparison.
  -->

</Project>
