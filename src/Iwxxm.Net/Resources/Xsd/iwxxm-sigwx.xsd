<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:iwxxm="http://icao.int/iwxxm/2025-2"
           xmlns:gml="http://www.opengis.net/gml/3.2"
           xmlns:xlink="http://www.w3.org/1999/xlink"
           targetNamespace="http://icao.int/iwxxm/2025-2"
           elementFormDefault="qualified"
           version="2025-2">

  <xs:import namespace="http://www.opengis.net/gml/3.2" schemaLocation="gml.xsd"/>
  <xs:import namespace="http://www.w3.org/1999/xlink" schemaLocation="xlink.xsd"/>

  <xs:simpleType name="ReportStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NORMAL"/>
      <xs:enumeration value="CORRECTION"/>
      <xs:enumeration value="AMENDMENT"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PermissibleUsageType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OPERATIONAL"/>
      <xs:enumeration value="NON-OPERATIONAL"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="StringWithNilReasonType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="nilReason" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="TimeInstantPropertyType">
    <xs:sequence minOccurs="0">
      <xs:element ref="gml:TimeInstant"/>
    </xs:sequence>
    <xs:attributeGroup ref="xlink:simpleAttrs"/>
    <xs:attribute name="nilReason" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="TimePeriodPropertyType">
    <xs:sequence minOccurs="0">
      <xs:element ref="gml:TimePeriod"/>
    </xs:sequence>
    <xs:attributeGroup ref="xlink:simpleAttrs"/>
    <xs:attribute name="nilReason" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- =====================================================================
       WMO IWXXM 2025-2 Official WAFSSignificantWeatherForecast & MetFeature
       ===================================================================== -->

  <xs:complexType name="ElevatedEnvelopeType">
    <xs:sequence>
      <xs:element ref="gml:lowerCorner"/>
      <xs:element ref="gml:upperCorner"/>
      <xs:element name="upperElevation" type="gml:MeasureType" nillable="true"/>
      <xs:element name="upperVerticalReference" type="xs:string" minOccurs="0"/>
      <xs:element name="lowerElevation" type="gml:MeasureType" nillable="true"/>
      <xs:element name="lowerVerticalReference" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ElevatedEnvelopePropertyType">
    <xs:sequence minOccurs="0">
      <xs:element name="ElevatedEnvelope" type="iwxxm:ElevatedEnvelopeType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ElevatedPointType">
    <xs:complexContent>
      <xs:extension base="gml:PointType">
        <xs:sequence>
          <xs:element name="elevation" type="gml:MeasureType" nillable="true" minOccurs="0"/>
          <xs:element name="verticalReference" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ElevatedPointPropertyType">
    <xs:sequence minOccurs="0">
      <xs:element name="ElevatedPoint" type="iwxxm:ElevatedPointType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ElevatedLevelType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="elevation" type="gml:MeasureType" nillable="true"/>
          <xs:element name="verticalReference" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ElevatedVolumeType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element ref="gml:patches"/>
          <xs:element name="upperElevation" type="gml:MeasureType" nillable="true" minOccurs="0"/>
          <xs:element name="upperVerticalReference" type="xs:string" minOccurs="0"/>
          <xs:element name="lowerElevation" type="gml:MeasureType" nillable="true" minOccurs="0"/>
          <xs:element name="lowerVerticalReference" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attributeGroup ref="gml:SRSReferenceGroup"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="WAFSJetStreamWindSymbolType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="location" type="iwxxm:ElevatedPointPropertyType"/>
          <xs:element name="windSpeed" type="gml:MeasureType" nillable="true"/>
          <xs:element name="IsotachUpperElevation" type="gml:MeasureType" nillable="true" minOccurs="0"/>
          <xs:element name="IsotachUpperVerticalReference" type="xs:string" minOccurs="0"/>
          <xs:element name="IsotachLowerElevation" type="gml:MeasureType" nillable="true" minOccurs="0"/>
          <xs:element name="IsotachLowerVerticalReference" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="WAFSVolcanoType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="name" type="iwxxm:StringWithNilReasonType" nillable="true"/>
          <xs:element name="IAVCEINumber" type="iwxxm:StringWithNilReasonType" nillable="true" minOccurs="0"/>
          <xs:element name="wmoNumber" type="xs:string" minOccurs="0"/>
          <xs:element name="location" type="iwxxm:PointPropertyType" minOccurs="0"/>
          <xs:element name="eruptionTime" type="xs:dateTime" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="TropicalCycloneType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="name" type="iwxxm:StringWithNilReasonType" nillable="true"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="RadiationIncidentType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="siteName" type="iwxxm:StringWithNilReasonType" nillable="true"/>
          <xs:element name="incidentTime" type="iwxxm:TimeInstantPropertyType"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="PhenomenonGeometryPropertyType">
    <xs:choice minOccurs="0">
      <xs:element ref="gml:Curve"/>
      <xs:element ref="gml:Polygon"/>
      <xs:element ref="gml:Point"/>
      <xs:element name="ElevatedVolume" type="iwxxm:ElevatedVolumeType"/>
      <xs:element name="ElevatedPoint" type="iwxxm:ElevatedPointType"/>
    </xs:choice>
    <xs:attributeGroup ref="xlink:simpleAttrs"/>
    <xs:attribute name="nilReason" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="PhenomenonPropertyRoleType">
    <xs:choice minOccurs="0">
      <xs:element name="WAFSJetStreamWindSymbol" type="iwxxm:WAFSJetStreamWindSymbolType"/>
      <xs:element name="DegreeOfTurbulence" type="gml:ReferenceType"/>
      <xs:element name="DegreeOfIcing" type="gml:ReferenceType"/>
      <xs:element name="CloudDistribution" type="gml:ReferenceType"/>
      <xs:element name="CloudType" type="gml:ReferenceType"/>
      <xs:element name="ElevatedLevel" type="iwxxm:ElevatedLevelType"/>
      <xs:element name="Volcano" type="iwxxm:WAFSVolcanoType"/>
      <xs:element name="TropicalCyclone" type="iwxxm:TropicalCycloneType"/>
      <xs:element name="RadiationIncident" type="iwxxm:RadiationIncidentType"/>
    </xs:choice>
    <xs:attributeGroup ref="xlink:simpleAttrs"/>
    <xs:attribute name="nilReason" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="OriginatingCentrePropertyType">
    <xs:sequence minOccurs="0">
      <xs:element name="WorldAreaForecastCentre" type="xs:string"/>
    </xs:sequence>
    <xs:attributeGroup ref="xlink:simpleAttrs"/>
  </xs:complexType>

  <xs:complexType name="MeteorologicalFeatureType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="issueTime" type="iwxxm:TimeInstantPropertyType" minOccurs="0"/>
          <xs:element name="originatingCentre" type="iwxxm:OriginatingCentrePropertyType" minOccurs="0"/>
          <xs:element name="phenomenonCategory" type="xs:string" minOccurs="0"/>
          <xs:element name="phenomenonBaseTime" type="iwxxm:TimeInstantPropertyType" minOccurs="0"/>
          <xs:element name="phenomenonTime" type="iwxxm:TimeInstantPropertyType" minOccurs="0"/>
          <xs:element name="phenomenon" type="gml:ReferenceType"/>
          <xs:element name="phenomenonGeometry" type="iwxxm:PhenomenonGeometryPropertyType" minOccurs="0"/>
          <xs:element name="phenomenonProperty" type="iwxxm:PhenomenonPropertyRoleType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="MeteorologicalFeaturePropertyType">
    <xs:sequence minOccurs="0">
      <xs:element name="MeteorologicalFeature" type="iwxxm:MeteorologicalFeatureType"/>
    </xs:sequence>
    <xs:attributeGroup ref="xlink:simpleAttrs"/>
    <xs:attribute name="nilReason" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="WAFSSignificantWeatherForecastType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="boundingPeriod" type="iwxxm:TimePeriodPropertyType" minOccurs="0"/>
          <xs:element name="boundingVolume" type="iwxxm:ElevatedEnvelopePropertyType" minOccurs="0"/>
          <xs:element name="phenomenaList" type="gml:ReferenceType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="issueTime" type="iwxxm:TimeInstantPropertyType"/>
          <xs:element name="originatingCentre" type="iwxxm:OriginatingCentrePropertyType"/>
          <xs:element name="phenomenonCategory" type="xs:string"/>
          <xs:element name="phenomenonBaseTime" type="iwxxm:TimeInstantPropertyType" minOccurs="0"/>
          <xs:element name="phenomenonTime" type="iwxxm:TimeInstantPropertyType" minOccurs="0"/>
          <xs:element name="feature" type="iwxxm:MeteorologicalFeaturePropertyType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="reportStatus" type="iwxxm:ReportStatusType" default="NORMAL"/>
        <xs:attribute name="permissibleUsage" type="iwxxm:PermissibleUsageType" default="OPERATIONAL"/>
        <xs:attribute name="permissibleUsageReason" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="WAFSSignificantWeatherForecast" type="iwxxm:WAFSSignificantWeatherForecastType"/>

  <!-- =====================================================================
       Compact SIGWXReport Element Support
       ===================================================================== -->

  <xs:complexType name="CurvePropertyType">
    <xs:sequence>
      <xs:element ref="gml:Curve"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PolygonPropertyType">
    <xs:sequence>
      <xs:element ref="gml:Polygon"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PointPropertyType">
    <xs:sequence>
      <xs:element ref="gml:Point"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="JetStreamCorePointType">
    <xs:sequence>
      <xs:element name="location" type="iwxxm:PointPropertyType"/>
      <xs:element name="flightLevel" type="gml:MeasureType"/>
      <xs:element name="windSpeed" type="gml:MeasureType"/>
      <xs:element name="lowerFlightLevel" type="gml:MeasureType" minOccurs="0"/>
      <xs:element name="upperFlightLevel" type="gml:MeasureType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="JetStreamType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="axis" type="iwxxm:CurvePropertyType"/>
          <xs:element name="flightLevel" type="gml:MeasureType"/>
          <xs:element name="windSpeed" type="gml:MeasureType"/>
          <xs:element name="corePoint" type="iwxxm:JetStreamCorePointType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="CloudDistributionFeatureType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="cloudAmount" type="xs:string"/>
          <xs:element name="cloudType" type="xs:string"/>
          <xs:element name="base" type="gml:MeasureType" minOccurs="0"/>
          <xs:element name="top" type="gml:MeasureType"/>
          <xs:element name="geometry" type="iwxxm:PolygonPropertyType"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="TropopausePointType">
    <xs:sequence>
      <xs:element name="location" type="iwxxm:PointPropertyType"/>
      <xs:element name="flightLevel" type="gml:MeasureType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TropopauseType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="levelType" type="xs:string" minOccurs="0"/>
          <xs:element name="spotHeight" type="iwxxm:TropopausePointType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="SIGWXReportType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractGMLType">
        <xs:sequence>
          <xs:element name="issueTime" type="iwxxm:TimeInstantPropertyType"/>
          <xs:element name="validPeriod" type="iwxxm:TimePeriodPropertyType"/>
          <xs:element name="issuingCentre" type="xs:string"/>
          <xs:element name="lowerLimit" type="gml:MeasureType"/>
          <xs:element name="upperLimit" type="gml:MeasureType"/>
          <xs:element name="jetStream" type="iwxxm:JetStreamType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="cloud" type="iwxxm:CloudDistributionFeatureType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="tropopause" type="iwxxm:TropopauseType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="volcano" type="iwxxm:WAFSVolcanoType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="reportStatus" type="iwxxm:ReportStatusType" default="NORMAL"/>
        <xs:attribute name="permissibleUsage" type="iwxxm:PermissibleUsageType" default="OPERATIONAL"/>
        <xs:attribute name="permissibleUsageReason" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="SIGWXReport" type="iwxxm:SIGWXReportType"/>

</xs:schema>
