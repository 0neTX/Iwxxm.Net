<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      .NET Standard 2.0 keeps the package usable from .NET Framework 4.6.1+ and from every modern .NET.
      Microsoft.Data.Sqlite 10.0.x is the last line that ships a netstandard2.0 asset (11.0 targets net10.0 only).
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Iwxxm.Net.Export.GeoPackage</RootNamespace>
    <AssemblyName>Iwxxm.Net.Export.GeoPackage</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>Iwxxm.Net.Export.GeoPackage</PackageId>
    <Title>Iwxxm.Net.Export.GeoPackage — OGC GeoPackage export for Iwxxm.Net</Title>
    <Product>Iwxxm.Net.Export.GeoPackage</Product>
    <Description>Optional Iwxxm.Net add-on for exporting IWXXM 2025-2 documents to OGC GeoPackage (.gpkg) files. Under development: this version does not contain the exporter yet. The SQLite file will be written with Microsoft.Data.Sqlite (MIT) and the native SQLite binaries of SQLitePCLRaw (Apache-2.0), so Iwxxm.Net itself keeps zero dependencies.</Description>
    <PackageTags>IWXXM;IWXXM-2025-2;Iwxxm.Net;GeoPackage;GPKG;OGC;SQLite;GIS;WMO;ICAO;Aviation;Meteorology</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The metapackage (not .Core): it brings the SQLitePCLRaw bundle that initializes the native SQLite on its own. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <ProjectReference Include="..\Iwxxm.Net\Iwxxm.Net.csproj" />
    <InternalsVisibleTo Include="Iwxxm.Net.Export.GeoPackage.Tests" />
  </ItemGroup>

</Project>
